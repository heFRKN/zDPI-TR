<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="zDPI" Width="380" Height="620" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        Background="#FF1A1A1C" Foreground="#F5F5F7" FontFamily="Segoe UI" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" GlassFrameThickness="-1" ResizeBorderThickness="0"
                  CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <SolidColorBrush x:Key="Text2" Color="#A1A1A6"/>
    <SolidColorBrush x:Key="Text3" Color="#6E6E73"/>
    <SolidColorBrush x:Key="Body" Color="#C7C7CC"/>
    <SolidColorBrush x:Key="GlassFill" Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="Hairline" Color="#14FFFFFF"/>

    <!-- Camin ust kenarindaki ince isik. Dolgular duz, yalnizca kenar isigi var. -->
    <LinearGradientBrush x:Key="GlassRim" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#2EFFFFFF" Offset="0"/>
      <GradientStop Color="#0DFFFFFF" Offset="0.4"/>
      <GradientStop Color="#0DFFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BrandRim" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#40FFFFFF" Offset="0"/>
      <GradientStop Color="#00FFFFFF" Offset="0.4"/>
    </LinearGradientBrush>

    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="Background" Value="#990033"/>
      <Setter Property="BorderBrush" Value="{StaticResource BrandRim}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border CornerRadius="14" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    RenderTransformOrigin="0.5,0.5">
              <Border.RenderTransform><ScaleTransform x:Name="Sc"/></Border.RenderTransform>
              <Grid>
                <Border x:Name="Hi" CornerRadius="13" Background="#FFFFFF" Opacity="0"/>
                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Hi" Property="Opacity" Value="0.07"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="0.98" Duration="0:0:0.08"/>
                      <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="0.98" Duration="0:0:0.08"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2"/>
                      <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="GlassButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="Foreground" Value="#F5F5F7"/>
      <Setter Property="Background" Value="{StaticResource GlassFill}"/>
      <Setter Property="BorderBrush" Value="{StaticResource GlassRim}"/>
    </Style>

    <Style x:Key="SegButton" TargetType="Button">
      <Setter Property="Foreground" Value="#A1A1A6"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="IconButton" TargetType="Button">
      <Setter Property="Width" Value="30"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Foreground" Value="#8E8E93"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="15" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/>
                <Setter Property="Foreground" Value="#F5F5F7"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#0DFFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Glyph" TargetType="Path">
      <Setter Property="Width" Value="16"/>
      <Setter Property="Height" Value="16"/>
      <Setter Property="StrokeThickness" Value="1.5"/>
      <Setter Property="StrokeStartLineCap" Value="Round"/>
      <Setter Property="StrokeEndLineCap" Value="Round"/>
      <Setter Property="StrokeLineJoin" Value="Round"/>
      <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/>
    </Style>

    <Style x:Key="Field" TargetType="TextBox">
      <Setter Property="Foreground" Value="#F5F5F7"/>
      <Setter Property="CaretBrush" Value="#F5F5F7"/>
      <Setter Property="SelectionBrush" Value="#CC1A55"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Bd" CornerRadius="12" Background="#14FFFFFF" BorderBrush="#1AFFFFFF"
                    BorderThickness="1" Padding="12,0">
              <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False"
                            HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#B3335C"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Width="46" Height="28" Background="Transparent">
              <Border x:Name="Track" CornerRadius="14">
                <Border.Background><SolidColorBrush Color="#33FFFFFF"/></Border.Background>
              </Border>
              <Ellipse Width="24" Height="24" Fill="#FFFFFF" HorizontalAlignment="Left" Margin="2,0,0,0">
                <Ellipse.RenderTransform><TranslateTransform x:Name="Tx"/></Ellipse.RenderTransform>
              </Ellipse>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Tx" Storyboard.TargetProperty="X" To="18" Duration="0:0:0.2">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                      <ColorAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#990033" Duration="0:0:0.2"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Tx" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.2">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                      <ColorAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#33FFFFFF" Duration="0:0:0.2"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="6"/>
      <Setter Property="MinWidth" Value="6"/>
      <Setter Property="Margin" Value="0,6,2,6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border CornerRadius="3" Background="#33FFFFFF"/>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Durum kartindaki bilgi satirlari -->
    <Style x:Key="InfoKey" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{StaticResource Text2}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="InfoValue" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Yardim metni -->
    <Style x:Key="H" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,26,0,0"/>
    </Style>
    <Style x:Key="P" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{StaticResource Body}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="LineHeight" Value="19"/>
      <Setter Property="Margin" Value="0,8,0,0"/>
    </Style>
    <Style x:Key="N" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{StaticResource Text3}"/>
      <Setter Property="LineHeight" Value="19"/>
      <Setter Property="Width" Value="18"/>
      <Setter Property="Margin" Value="0,8,0,0"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Border x:Name="Tint" Background="Transparent"/>

    <Grid Margin="20,0,20,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="50"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- ============================================================ baslik -->
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Grid Width="22" Height="22">
          <Border CornerRadius="6" Background="#990033" BorderThickness="1" BorderBrush="{StaticResource BrandRim}"/>
          <Path Data="M 7.5,7.6 L 14.5,7.6 L 7.5,14.4 L 14.5,14.4" Stroke="#FFFFFF" StrokeThickness="2.3"
                StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
        </Grid>
        <TextBlock Text="zDPI" FontSize="14" FontWeight="SemiBold" Margin="9,0,0,1" VerticalAlignment="Center"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-10,0">
        <Button x:Name="MinBtn" Style="{StaticResource IconButton}" ToolTip="Simge durumuna küçült">
          <Path Style="{StaticResource Glyph}" Data="M 4,8 H 12"/>
        </Button>
        <Button x:Name="CloseBtn" Style="{StaticResource IconButton}" Margin="2,0,0,0" ToolTip="Kapat">
          <Path Style="{StaticResource Glyph}" Data="M 4.5,4.5 L 11.5,11.5 M 11.5,4.5 L 4.5,11.5"/>
        </Button>
      </StackPanel>

      <!-- ============================================================ sekmeler -->
      <Border Grid.Row="1" Height="34" CornerRadius="10" Padding="2" Background="#14FFFFFF"
              BorderBrush="{StaticResource GlassRim}" BorderThickness="1">
        <Grid x:Name="SegHost">
          <Border x:Name="SegThumb" HorizontalAlignment="Left" CornerRadius="8" Background="#2BFFFFFF"
                  BorderBrush="#1FFFFFFF" BorderThickness="1">
            <Border.RenderTransform><TranslateTransform x:Name="SegTx"/></Border.RenderTransform>
          </Border>
          <UniformGrid Columns="3">
            <Button x:Name="Tab0" Style="{StaticResource SegButton}" Content="Durum"/>
            <Button x:Name="Tab1" Style="{StaticResource SegButton}" Content="Siteler"/>
            <Button x:Name="Tab2" Style="{StaticResource SegButton}" Content="Nasıl kullanılır"/>
          </UniformGrid>
        </Grid>
      </Border>

      <Grid Grid.Row="2" Margin="0,16,0,0">

        <!-- ======================================================== durum -->
        <StackPanel x:Name="StatusTab">
          <Border CornerRadius="16" Background="{StaticResource GlassFill}" BorderBrush="{StaticResource GlassRim}" BorderThickness="1">
            <StackPanel>
              <StackPanel Margin="18,16,18,16">
                <StackPanel Orientation="Horizontal">
                  <Grid Width="12" Height="12" VerticalAlignment="Center" Margin="0,2,0,0">
                    <Ellipse x:Name="Dot" Width="10" Height="10" Fill="#8E8E93"/>
                    <Path x:Name="Spinner" Data="M 6,1 A 5,5 0 0 1 11,6" Stroke="#F5F5F7" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"
                          RenderTransformOrigin="0.5,0.5">
                      <Path.RenderTransform><RotateTransform x:Name="SpinRotate"/></Path.RenderTransform>
                    </Path>
                  </Grid>
                  <TextBlock x:Name="StatusTitle" FontSize="22" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="StatusSub" FontSize="13" Foreground="{StaticResource Text2}" TextWrapping="Wrap" Margin="22,3,0,0"/>
                <TextBlock x:Name="Notice" FontSize="12.5" TextWrapping="Wrap" LineHeight="18" Margin="22,10,0,0" Visibility="Collapsed"/>
              </StackPanel>

              <Border Height="1" Background="{StaticResource Hairline}"/>
              <Grid Height="40" Margin="18,0">
                <TextBlock Style="{StaticResource InfoKey}" Text="Hizmet"/>
                <TextBlock x:Name="InfoService" Style="{StaticResource InfoValue}"/>
              </Grid>
              <Border Height="1" Background="{StaticResource Hairline}" Margin="18,0,0,0"/>
              <Grid Height="40" Margin="18,0">
                <TextBlock Style="{StaticResource InfoKey}" Text="Tek seferlik mod"/>
                <TextBlock x:Name="InfoOneShot" Style="{StaticResource InfoValue}"/>
              </Grid>
              <Border Height="1" Background="{StaticResource Hairline}" Margin="18,0,0,0"/>
              <Grid Height="40" Margin="18,0">
                <TextBlock Style="{StaticResource InfoKey}" Text="Site listesi"/>
                <TextBlock x:Name="InfoSites" Style="{StaticResource InfoValue}"/>
              </Grid>
              <Border Height="1" Background="{StaticResource Hairline}" Margin="18,0,0,0"/>
              <Grid Height="40" Margin="18,0">
                <TextBlock Style="{StaticResource InfoKey}" Text="Şifreli DNS"/>
                <TextBlock x:Name="InfoDns" Style="{StaticResource InfoValue}"/>
              </Grid>
            </StackPanel>
          </Border>

          <Button x:Name="PrimaryBtn" Style="{StaticResource PrimaryButton}" Height="50" Margin="0,16,0,0" Content="Hizmeti kur"/>
          <Button x:Name="SecondaryBtn" Style="{StaticResource GlassButton}" Height="50" Margin="0,10,0,0" Content="Tek seferlik başlat"/>
          <TextBlock x:Name="Hint" FontSize="12" Foreground="{StaticResource Text3}" TextWrapping="Wrap" LineHeight="17" Margin="4,12,4,0"/>
        </StackPanel>

        <!-- ======================================================== siteler -->
        <Grid x:Name="SitesTab" Margin="0,0,0,16" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock x:Name="SitesCaption" FontSize="12.5" Foreground="{StaticResource Text2}" TextWrapping="Wrap" LineHeight="18" Margin="2,0,2,12"/>

          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="Input" Style="{StaticResource Field}" Height="44"/>
            <TextBlock x:Name="Placeholder" Text="site.com" FontSize="14" Foreground="{StaticResource Text3}"
                       Margin="15,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            <Button x:Name="AddBtn" Grid.Column="1" Style="{StaticResource PrimaryButton}" Width="44" Height="44" Margin="8,0,0,0" Padding="0" ToolTip="Ekle">
              <Path Data="M 8,2.5 V 13.5 M 2.5,8 H 13.5" Width="16" Height="16" Stroke="#FFFFFF" StrokeThickness="1.8"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Button>
          </Grid>

          <Border Grid.Row="2" Margin="0,12,0,0" CornerRadius="16" Background="{StaticResource GlassFill}"
                  BorderBrush="{StaticResource GlassRim}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
              <ItemsControl x:Name="SiteList" Margin="0,2">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Height="42" Margin="16,0,8,0">
                      <Border Height="1" VerticalAlignment="Top" Background="#12FFFFFF" Visibility="{Binding SeparatorVisibility}"/>
                      <TextBlock Text="{Binding Display}" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,40,0"/>
                      <Path Visibility="{Binding LockVisibility}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,7,0"
                            Width="16" Height="16" Stroke="#6E6E73" StrokeThickness="1.3" StrokeLineJoin="Round" StrokeEndLineCap="Round" StrokeStartLineCap="Round"
                            ToolTip="Varsayılan, kaldırılamaz"
                            Data="M 4.5,7.5 H 11.5 A 1,1 0 0 1 12.5,8.5 V 12.5 A 1,1 0 0 1 11.5,13.5 H 4.5 A 1,1 0 0 1 3.5,12.5 V 8.5 A 1,1 0 0 1 4.5,7.5 Z M 5.5,7.5 V 5.5 A 2.5,2.5 0 0 1 10.5,5.5 V 7.5"/>
                      <Button Visibility="{Binding RemoveVisibility}" Style="{StaticResource IconButton}" HorizontalAlignment="Right" ToolTip="Kaldır">
                        <Path Style="{StaticResource Glyph}" Data="M 4.5,4.5 L 11.5,11.5 M 11.5,4.5 L 4.5,11.5"/>
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>

          <Border Grid.Row="3" Margin="0,12,0,0" CornerRadius="16" Padding="16,11" Background="{StaticResource GlassFill}"
                  BorderBrush="{StaticResource GlassRim}" BorderThickness="1">
            <Grid>
              <StackPanel VerticalAlignment="Center" Margin="0,0,56,0">
                <TextBlock Text="Şifreli DNS" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock Text="Site yine açılmıyorsa açın" FontSize="12" Foreground="{StaticResource Text2}" Margin="0,1,0,0"/>
              </StackPanel>
              <CheckBox x:Name="DnsSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
          </Border>

          <Button x:Name="SaveBtn" Grid.Row="4" Style="{StaticResource PrimaryButton}" Height="50" Margin="0,12,0,0" Content="Kaydet ve uygula"/>
        </Grid>

        <!-- ======================================================== nasil kullanilir -->
        <ScrollViewer x:Name="HelpTab" VerticalScrollBarVisibility="Auto" Focusable="False" Margin="0,0,-12,0" Visibility="Collapsed">
          <StackPanel Margin="2,0,16,20">
            <TextBlock Style="{StaticResource P}" Margin="0,2,0,0">
              zDPI, internet sağlayıcınızın engellediği sitelere VPN olmadan erişmenizi sağlar.
              Trafiğiniz başka bir sunucuya gitmez; yalnızca bağlantının ilk paketi, araya giren filtrenin
              okuyamayacağı şekilde düzenlenir. Bu yüzden hızınız ve ping'iniz değişmez.
            </TextBlock>

            <TextBlock Style="{StaticResource H}" Text="İki mod"/>
            <TextBlock Style="{StaticResource P}">
              <Run FontWeight="SemiBold" Foreground="#F5F5F7">Hizmet.</Run>
              Bir kez kurulur, bilgisayar her açıldığında arka planda kendiliğinden çalışır. Yalnızca
              Siteler sekmesindeki adreslere dokunur; oyunlar ve diğer her şey olduğu gibi geçer.
              Günlük kullanım için bunu kurun.
            </TextBlock>
            <TextBlock Style="{StaticResource P}">
              <Run FontWeight="SemiBold" Foreground="#F5F5F7">Tek seferlik.</Run>
              Kurulum yapmaz. Bu pencere açık kaldığı sürece engelli tüm sitelerde çalışır, pencereyi
              kapatınca durur. Hizmet kuruluysa o sırada duraklar, sonra kaldığı yerden devam eder.
            </TextBlock>

            <TextBlock Style="{StaticResource H}" Text="Kurulum"/>
            <DockPanel>
              <TextBlock Style="{StaticResource N}" Text="1" DockPanel.Dock="Left"/>
              <TextBlock Style="{StaticResource P}">Durum sekmesinde <Run FontWeight="SemiBold" Foreground="#F5F5F7">Hizmeti kur</Run>'a basın.</TextBlock>
            </DockPanel>
            <DockPanel>
              <TextBlock Style="{StaticResource N}" Text="2" DockPanel.Dock="Left"/>
              <TextBlock Style="{StaticResource P}">
                zDPI, hattınızda çalışan yöntemi bulmak için 13 yöntemi sırayla dener. Bu 1-2 dakika
                sürebilir, pencereyi kapatmayın.
              </TextBlock>
            </DockPanel>
            <DockPanel>
              <TextBlock Style="{StaticResource N}" Text="3" DockPanel.Dock="Left"/>
              <TextBlock Style="{StaticResource P}">Durum "Açık" olduğunda bitti. Bir daha bir şey yapmanız gerekmez.</TextBlock>
            </DockPanel>

            <TextBlock Style="{StaticResource H}" Text="Site eklemek"/>
            <DockPanel>
              <TextBlock Style="{StaticResource N}" Text="1" DockPanel.Dock="Left"/>
              <TextBlock Style="{StaticResource P}">
                Siteler sekmesinde adresi yazıp Enter'a basın. Tarayıcıdan kopyaladığınız linki de
                yapıştırabilirsiniz; zDPI onu site.com biçimine indirir.
              </TextBlock>
            </DockPanel>
            <DockPanel>
              <TextBlock Style="{StaticResource N}" Text="2" DockPanel.Dock="Left"/>
              <TextBlock Style="{StaticResource P}"><Run FontWeight="SemiBold" Foreground="#F5F5F7">Kaydet ve uygula</Run>'ya basın.</TextBlock>
            </DockPanel>
            <DockPanel>
              <TextBlock Style="{StaticResource N}" Text="3" DockPanel.Dock="Left"/>
              <TextBlock Style="{StaticResource P}">
                Hizmet kuruluysa birkaç saniye içinde yeni listeyle yeniden başlar; yeniden kurmanız
                gerekmez. Sayfayı yenileyin, açılmazsa tarayıcıyı kapatıp açın.
              </TextBlock>
            </DockPanel>
            <TextBlock Style="{StaticResource P}" Margin="0,12,0,0">
              Eklediğiniz adresin alt adresleri de dahildir: site.com, www.site.com ve cdn.site.com'u da
              kapsar. Kilitli adresler varsayılan listedir ve kaldırılamaz.
            </TextBlock>
            <TextBlock Style="{StaticResource P}">
              Tek seferlik mod açıkken kaydederseniz liste hemen kaydedilir, ama hizmet o sırada duraklatıldığı
              için tek seferlik modu kapattığınızda geçerli olur.
            </TextBlock>

            <TextBlock Style="{StaticResource H}" Text="Site hâlâ açılmıyorsa"/>
            <DockPanel>
              <TextBlock Style="{StaticResource N}" Text="·" DockPanel.Dock="Left"/>
              <TextBlock Style="{StaticResource P}">
                Siteler sekmesinden <Run FontWeight="SemiBold" Foreground="#F5F5F7">Şifreli DNS</Run>'i açın.
                Bazı siteler adres çözme aşamasında da engellenir, şifreli DNS bunu aşar.
              </TextBlock>
            </DockPanel>
            <DockPanel>
              <TextBlock Style="{StaticResource N}" Text="·" DockPanel.Dock="Left"/>
              <TextBlock Style="{StaticResource P}">
